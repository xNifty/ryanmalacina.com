<div class="wrap page">
    <h1 class="page-title">News</h1>
    <p class="page-intro">Updates about the site and what I'm working on.</p>

    {{!-- A plain GET form, so search works without JavaScript; htmx swaps just the results --}}
    <form class="news-search" role="search" action="/news" method="get"
        hx-get="/news" hx-target="#news-results" hx-push-url="true" hx-trigger="submit, change from:#news-sort">
        <label class="visually-hidden" for="news-q">Search news</label>
        <input class="input" type="search" id="news-q" name="q" value="{{ q }}" placeholder="Search news…" maxlength="100">
        <label class="visually-hidden" for="news-sort">Sort</label>
        <select class="input" id="news-sort" name="sort">
            {{#each sorts}}<option value="{{ key }}"{{#if selected}} selected{{/if}}>{{ label }}</option>{{/each}}
        </select>
        <button class="button button--primary" type="submit">Search</button>
    </form>

    <div id="news-results" aria-live="polite">
        {{> news/results }}
    </div>
</div>
