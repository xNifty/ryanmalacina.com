<div class="wrap auth">
    <div class="auth-card auth-card--wide">
        <h1 class="auth-card__title">Your profile</h1>
        <p class="auth-card__intro">Change your name, email or password. Your username can't be changed.</p>
        <form class="auth-form" method="post" action="/profile" id="profile_content">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <div class="field">
                <label class="field__label" for="user_name">Name</label>
                <input class="input" id="user_name" name="user_name" type="text" autocomplete="name" value="{{ user_name }}" required>
            </div>
            <div class="field">
                <label class="field__label" for="user_email">Email</label>
                <input class="input" id="user_email" name="user_email" type="email" autocomplete="email" value="{{ user_email }}" required>
            </div>
            <details class="disclosure">
                <summary>Change password</summary>
                <div class="disclosure__body">
                    <div class="field">
                        <label class="field__label" for="pass_change_one">New password</label>
                        <input class="input" id="pass_change_one" name="pass_change_one" type="password" autocomplete="new-password" minlength="8">
                    </div>
                    <div class="field">
                        <label class="field__label" for="pass_change_two">Confirm new password</label>
                        <input class="input" id="pass_change_two" name="pass_change_two" type="password" autocomplete="new-password" minlength="8" aria-describedby="passwordMatchError">
                        <p class="field__hint caps-warning" id="passwordMatchError" aria-live="polite"></p>
                    </div>
                    <div class="field">
                        <label class="field__label" for="pass_current">Current password</label>
                        <input class="input" id="pass_current" name="pass_current" type="password" autocomplete="current-password">
                    </div>
                </div>
            </details>
            <button class="button button--primary" type="submit">Save profile</button>
        </form>
    </div>
</div>
