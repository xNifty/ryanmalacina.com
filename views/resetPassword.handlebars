{{!-- Posts back to its own URL, which carries the reset token and id --}}
<div class="wrap auth">
    <div class="auth-card">
        <h1 class="auth-card__title">Choose a new password</h1>
        <p class="auth-card__intro">At least 8 characters.</p>
        <form class="auth-form" method="post">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <div class="field">
                <label class="field__label" for="password_one">New password</label>
                <input class="input" id="password_one" name="password_one" type="password" autocomplete="new-password" minlength="8" required data-caps-warning="reset-caps">
            </div>
            <div class="field">
                <label class="field__label" for="password_two">Confirm new password</label>
                <input class="input" id="password_two" name="password_two" type="password" autocomplete="new-password" minlength="8" required data-caps-warning="reset-caps">
                <span class="caps-warning" id="reset-caps" hidden>Caps Lock is on</span>
            </div>
            <button class="button button--primary" type="submit">Change password</button>
        </form>
    </div>
</div>
