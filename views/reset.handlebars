<div class="wrap auth">
    <div class="auth-card">
        <h1 class="auth-card__title">Forgot your password?</h1>
        <p class="auth-card__intro">Enter your account's email and we'll send a reset link if it matches.</p>
        <form class="auth-form" method="post" action="/reset">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <div class="field">
                <label class="field__label" for="email_one">Email</label>
                <input class="input" id="email_one" name="email_one" type="email" autocomplete="email" required>
            </div>
            <div class="field">
                <label class="field__label" for="email_two">Confirm email</label>
                <input class="input" id="email_two" name="email_two" type="email" autocomplete="email" required>
            </div>
            <button class="button button--primary" type="submit">Send reset link</button>
        </form>
        <p class="auth-card__links"><a href="/login">Back to log in</a></p>
    </div>
</div>
