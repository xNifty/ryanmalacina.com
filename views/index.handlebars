<section class="hero" aria-labelledby="hero-name">
    <div class="wrap hero__grid">
        <div class="hero__intro">
            <p class="hero__prompt"><span>$</span> echo $NAME</p>
            <h1 class="hero__name" id="hero-name">Ryan Malacina</h1>
            <div class="hero__actions">
                <a class="button button--primary" href="/projects">View projects {{> icon name="arrow-right" }}</a>
                <a class="button" href="#contact">Get in touch</a>
            </div>
        </div>
        {{> terminal }}
    </div>
</section>

<section class="section" aria-labelledby="featured-heading">
    <div class="wrap">
        <div class="section__header">
            <h2 class="section__title" id="featured-heading">featured projects</h2>
            <a class="section__more" href="/projects">all {{ project_count }} projects →</a>
        </div>
        {{#if projects.length}}
            <div class="card-grid">
                {{#each projects}}{{> project-card this }}{{/each}}
            </div>
        {{else}}
            <p class="empty">No featured projects yet. <a href="/projects">See them all</a>.</p>
        {{/if}}
    </div>
</section>

{{#if showNews}}
    <section class="section" aria-labelledby="news-heading">
        <div class="wrap">
            <div class="section__header">
                <h2 class="section__title" id="news-heading">latest news</h2>
                <a class="section__more" href="/news">all news →</a>
            </div>
            <ul class="post-list">
                {{#each news}}
                    <li>
                        <details class="post-entry">
                            <summary class="post-row">
                                <time class="post-row__date" datetime="{{ formatDate publishedAt "isoUtcDateTime" }}">{{ formatDate publishedAt "mmm d, yyyy" }}</time>
                                <span class="post-row__title">{{ title }}</span>
                                <span class="post-row__arrow post-entry__chevron" aria-hidden="true">›</span>
                            </summary>
                            <div class="post-entry__body">
                                <div class="markdown-body">
                                    {{{ bodyHtml }}}
                                </div>
                                <a class="post-entry__link" href="/news/{{ slug }}">permalink →</a>
                            </div>
                        </details>
                    </li>
                {{/each}}
            </ul>
        </div>
    </section>
{{/if}}

{{#if showBlog}}
    {{> blog }}
{{/if}}

{{> contact }}
