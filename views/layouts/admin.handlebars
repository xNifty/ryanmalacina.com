{{!-- Admin layout: every page under /admin (routes/admin/index.js sets it). No Bootstrap or
      jQuery; styles are public/css/admin.css, behaviour is htmx plus public/js/admin.js.
      section: dashboard | projects | news marks the current nav item. --}}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ title }}</title>
    <script nonce="{{ nonce }}">
    (function() {
        var match = document.cookie.match(/(?:^|; )theme=([^;]*)/);
        var theme = match ? decodeURIComponent(match[1]) : null;
        if (theme !== 'light' && theme !== 'dark') {
            theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
    })();
    </script>
    <meta name="htmx-config" content='{"inlineScriptNonce":"{{ nonce }}","inlineStyleNonce":"{{ nonce }}","includeIndicatorStyles":false}'>
    <link rel="stylesheet" href="{{ versionedFile 'admin.css' 'dist' 'css' }}">
    {{!-- The accent colour from Settings --}}
    {{#if accentCss}}<style nonce="{{ nonce }}">{{{ accentCss }}}</style>{{/if}}
    <link rel="shortcut icon" href="/images/favicon.ico">
    {{!-- The CSP requires Trusted Types; this defines the policy htmx's swaps go through --}}
    <script src="{{ versionedFile 'trustedtype.js' 'dist' 'js' }}" nonce="{{ nonce }}"></script>
</head>
<body class="admin" hx-headers='{"X-CSRF-Token": "{{ csrfToken }}"}'>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="admin-shell">
        <header class="admin-sidebar">
            <a class="admin-brand" href="/admin">ryanmalacina.com <span class="admin-brand__tag">Admin</span></a>
            <nav class="admin-nav" aria-label="Admin">
                <ul>
                    <li><a href="/admin"{{#iff section "==" "dashboard"}} aria-current="page"{{/iff}}>Dashboard</a></li>
                    <li><a href="/admin/projects"{{#iff section "==" "projects"}} aria-current="page"{{/iff}}>Projects</a></li>
                    <li><a href="/admin/news"{{#iff section "==" "news"}} aria-current="page"{{/iff}}>News</a></li>
                    <li><a href="/admin/pages"{{#iff section "==" "pages"}} aria-current="page"{{/iff}}>Pages</a></li>
                    <li><a href="/admin/settings"{{#iff section "==" "settings"}} aria-current="page"{{/iff}}>Settings</a></li>
                </ul>
            </nav>
            <div class="admin-sidebar__footer">
                <a href="/">View site</a>
                <a href="/profile">Profile</a>
                <button type="button" class="theme-toggle link-button">
                    <span class="theme-label theme-label--dark">Dark mode</span>
                    <span class="theme-label theme-label--light">Light mode</span>
                </button>
                <form method="post" action="/logout">
                    <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                    <button type="submit" class="link-button">Log out</button>
                </form>
            </div>
        </header>
        <main id="main" class="admin-main" tabindex="-1">
            {{{ body }}}
        </main>
    </div>
    <div id="toasts" class="toasts" aria-live="polite">
        {{#each success}}{{> admin/toast type="success" message=this }}{{/each}}
        {{#each error}}{{> admin/toast type="error" message=this }}{{/each}}
    </div>
    <script src="https://unpkg.com/htmx.org@2.0.10/dist/htmx.min.js" nonce="{{ nonce }}"></script>
    <script src="{{ versionedFile 'theme.js' 'dist' 'js' }}" nonce="{{ nonce }}"></script>
    <script src="{{ versionedFile 'admin.js' 'dist' 'js' }}" nonce="{{ nonce }}"></script>
</body>
</html>
