{{!-- Admin layout: every page behind ValidateAdmin --}}
<!doctype HTML>
<html>
{{> header}}
<body>
    {{> theme-script}}
    {{> nav}}
    <div id="statusBox" hx-target="this" hx-swap="innerHTML" hx-trigger="load">{{> status}}</div>
    {{{ body }}}

    {{!-- Target for the HTMX delete-confirmation modal --}}
    <div id="confirmation-modal"></div>

    {{> footer currentyear=currentyear}}
    {{> scripts}}
    <script src="{{ versionedFile 'admin.js' 'dist' 'js'}}" nonce="{{nonce}}"></script>
</body>
</html>
