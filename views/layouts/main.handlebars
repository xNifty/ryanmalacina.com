{{!-- Public layout. Routes can set:
      section: projects | news | about  (current nav link)
      highlight: true                   (code highlighting, for pages with markdown)
      pageScripts: ["profile.js"]       (extra webpack entries)
      hideLogin: true                   (no "Log in" link, e.g. on the reset pages) --}}
<!doctype html>
<html lang="en">
{{> header }}
<body>
    {{> theme-script }}
    <a class="skip-link" href="#main">Skip to content</a>
    {{> nav }}
    <div id="statusBox">{{> status }}</div>
    <main id="main" tabindex="-1">
        {{{ body }}}
    </main>
    {{> footer }}
    {{> scripts }}
</body>
</html>
