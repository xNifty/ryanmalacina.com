{{!-- Site header. section (projects | news | about) marks the current link. --}}
<header class="site-header">
    <div class="wrap site-header__inner">
        <a class="brand" href="/" aria-label="Ryan Malacina, home">
            <span class="brand__host">ryan@malacina</span>:<span class="brand__path">~</span>$<span class="brand__cursor" aria-hidden="true"></span>
        </a>
        <button type="button" class="icon-button menu-toggle" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
            <span class="visually-hidden">Menu</span>
            {{> icon name="menu" }}
        </button>
        <nav class="site-nav" id="site-nav" aria-label="Main">
            <ul class="site-nav__list">
                <li><a class="site-nav__link" href="/projects"{{#iff section "==" "projects"}} aria-current="page"{{/iff}}>Projects</a></li>
                <li><a class="site-nav__link" href="/news"{{#iff section "==" "news"}} aria-current="page"{{/iff}}>News</a></li>
                {{#if displayBlogNav}}
                    <li><a class="site-nav__link" href="/blog/">Blog</a></li>
                {{/if}}
                <li><a class="site-nav__link" href="/about"{{#iff section "==" "about"}} aria-current="page"{{/iff}}>About</a></li>
                <li><a class="site-nav__link" href="/#contact">Contact</a></li>
                {{#if isAdmin}}
                    <li><a class="site-nav__link" href="/admin">Admin</a></li>
                {{/if}}
            </ul>
        </nav>
        <button type="button" class="icon-button theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
            {{> icon name="moon" }}
            {{> icon name="sun" }}
        </button>
    </div>
</header>
