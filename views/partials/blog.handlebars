{{!-- Latest Ghost posts; only rendered while the blog is switched on in /admin/settings --}}
<section class="section" aria-labelledby="blog-heading">
    <div class="wrap">
        <div class="section__header">
            <h2 class="section__title" id="blog-heading">from the blog</h2>
            <a class="section__more" href="{{ blogURL }}">visit the blog →</a>
        </div>
        {{#if blogPosts.length}}
            <ul class="post-list">
                {{#each blogPosts}}
                    <li class="post-row">
                        <time class="post-row__date" datetime="{{ published_at }}">{{ formatDate published_at "mmm d, yyyy" }}</time>
                        <a class="post-row__title" href="{{ url }}">{{ title }}</a>
                        <span class="post-row__arrow" aria-hidden="true">↗</span>
                    </li>
                {{/each}}
            </ul>
        {{else}}
            <p class="empty">Couldn't load the latest posts. <a href="{{ blogURL }}">Read them on the blog</a>.</p>
        {{/if}}
    </div>
</section>
