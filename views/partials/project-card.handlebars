{{!-- One project card. Uses the project's image if it has its own, else a monogram. --}}
<article class="project-card">
    <div class="project-card__media">
        {{#iff image "!==" "default.png"}}
            <img class="project-card__image" src="/images/{{ image }}" alt="" width="48" height="48" loading="lazy">
        {{else}}
            <span class="monogram" aria-hidden="true">{{ initials name }}</span>
        {{/iff}}
        <span class="project-card__arrow">{{> icon name="arrow-right" }}</span>
    </div>
    <h3 class="project-card__name"><a href="/projects/{{ slug }}">{{ name }}</a></h3>
    {{#iff title "!==" name}}<p class="project-card__title">{{ title }}</p>{{/iff}}
    {{#if tags.length}}
        <ul class="tags" aria-label="Tags">
            {{#each tags}}<li class="tag">{{ this }}</li>{{/each}}
        </ul>
    {{/if}}
</article>
