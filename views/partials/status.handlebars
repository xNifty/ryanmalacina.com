{{!-- One-time flash messages (req.flash). Not on the error page, which uses "error" for its own message. --}}
{{#unless status_code}}
    {{#if success.length}}
        <div class="wrap flash-stack">
            {{#each success}}
                <div class="flash" role="status">
                    <span class="flash__message">{{ this }}</span>
                    <button type="button" class="flash__close" data-flash-close aria-label="Dismiss">&times;</button>
                </div>
            {{/each}}
        </div>
    {{/if}}
    {{#if error.length}}
        <div class="wrap flash-stack">
            {{#each error}}
                <div class="flash flash--error" role="alert">
                    <span class="flash__message">{{ this }}</span>
                    <button type="button" class="flash__close" data-flash-close aria-label="Dismiss">&times;</button>
                </div>
            {{/each}}
        </div>
    {{/if}}
{{/unless}}
