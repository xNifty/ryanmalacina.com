{{!-- Message rendered alone as an HTMX response, e.g. a failed login (see utils/renderPartial.js).
      type: success | danger; messages: list of lines, escaped --}}
<div class="form-message{{#iff type "==" "success"}} form-message--success{{/iff}}" role="alert">
    {{#each messages}}{{ this }}{{#unless @last}}<br>{{/unless}}{{/each}}
</div>
