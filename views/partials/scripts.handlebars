{{!-- Scripts for the public layout. No jQuery or Bootstrap. --}}
<script src="https://unpkg.com/htmx.org@2.0.10/dist/htmx.min.js" nonce="{{ nonce }}"></script>
<script src="https://unpkg.com/htmx-ext-response-targets@2.0.4/dist/response-targets.js" nonce="{{ nonce }}"></script>
{{#if highlight}}
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js" nonce="{{ nonce }}"></script>
{{/if}}
<script src="{{ versionedFile 'site.js' 'dist' 'js' }}" nonce="{{ nonce }}"></script>
{{#each pageScripts}}
<script src="{{ versionedFile this 'dist' 'js' }}" nonce="{{ @root.nonce }}"></script>
{{/each}}
