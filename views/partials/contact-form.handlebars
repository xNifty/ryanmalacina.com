{{!-- Contact form body. Rendered inside partials/contact on the home page, and on its own as
      the HTMX response from POST /send, which swaps #contactformdiv. Context from /send:
      contactSent (success message), errors (list), invalid.<field>, values.<field> --}}
<div id="contactformdiv">
{{#if contactSent}}
    <div class="alert alert--success" id="emailalert" role="status">
        <span id="emailerror">{{ contactSent }}</span>
    </div>
{{else}}
    <form id="contact-form" class="contact-form" hx-post="/send" hx-target="#contactformdiv" hx-swap="outerHTML swap:0 settle:0">
        <div class="alert alert--error{{#if errors}} emailalert-visible{{/if}}" id="emailalert" role="alert">
            <span id="emailerror">{{#each errors}}{{ this }}{{#unless @last}}<br>{{/unless}}{{/each}}</span>
        </div>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="form-grid">
            <div class="field">
                <label class="field__label" for="name">Your name</label>
                <input type="text" id="name" name="name" class="input{{#if invalid.name}} invalid{{/if}}" autocomplete="name" value="{{ values.name }}"{{#if invalid.name}} aria-invalid="true"{{/if}}>
            </div>
            <div class="field">
                <label class="field__label" for="email">Your email</label>
                <input type="email" id="email" name="email" class="input{{#if invalid.email}} invalid{{/if}}" autocomplete="email" value="{{ values.email }}"{{#if invalid.email}} aria-invalid="true"{{/if}}>
            </div>
            <div class="field field--wide">
                <label class="field__label" for="subject">Subject</label>
                <input type="text" id="subject" name="subject" class="input{{#if invalid.subject}} invalid{{/if}}" autocomplete="off" value="{{ values.subject }}"{{#if invalid.subject}} aria-invalid="true"{{/if}}>
            </div>
            <div class="field field--wide">
                <label class="field__label" for="message">Message</label>
                <textarea id="message" name="message" rows="5" class="input{{#if invalid.message}} invalid{{/if}}"{{#if invalid.message}} aria-invalid="true"{{/if}}>{{ values.message }}</textarea>
            </div>
        </div>
        {{!-- Cloudflare Turnstile; public/js/site.js renders it. It stays out of sight unless
              Cloudflare wants the visitor to tick a box. --}}
        <div class="turnstile" data-turnstile data-sitekey="{{ turnstileSiteKey }}"></div>
        <div class="contact-form__footer">
            <button class="button button--primary" type="submit">Send message</button>
        </div>
    </form>
{{/if}}
</div>
