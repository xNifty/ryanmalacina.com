{{!-- Contact form body. Rendered inside partials/contact on the home page, and on its own as
      the HTMX response from POST /send, which swaps #contactformdiv. Context from /send:
      contactSent (success message), errors (list), invalid.<field>, values.<field> --}}
<div id="contactformdiv">
{{#if contactSent}}
    <div class="text-center emailalert-visible" id="emailalert">
        <div class="alert alert-success alert-dismissible center-block">
            <span id="emailerror">{{ contactSent }}</span>
        </div>
    </div>
{{else}}
    <div class="section-intro">
        Shoot me a message and I'll get back to you as soon as I can.
        If you are reporting an issue that is not a security vulnerability, please do so <a href="https://github.com/xNifty/ryanmalacina.com/issues">here</a>.<br>
    </div>
    <div class="text-center{{#if errors}} emailalert-visible{{/if}}" id="emailalert">
        <div class="alert alert-danger center-block">
            <span id="emailerror">{{#each errors}}{{ this }}{{#unless @last}}<br>{{/unless}}{{/each}}</span>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 mb-md-0 mb-5">
            <form id="contact-form" hx-post="/send" hx-target="#contactformdiv" hx-swap="outerHTML swap:0 settle:0">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <div class="row">
                    <div class="col-md-6">
                        <div class="md-form mb-0">
                            <label for="name" class="">Your Name</label>
                            <input type="text" id="name" name="name" class="form-control{{#if invalid.name}} invalid{{/if}}" placeholder="John Doe" autocomplete="off" value="{{ values.name }}">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="md-form mb-0">
                            <label for="email" class="">Your Email</label>
                            <input type="text" id="email" name="email" class="form-control{{#if invalid.email}} invalid{{/if}}" placeholder="you@your.email" autocomplete="on" value="{{ values.email }}">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="md-form mb-0">
                            <label for="subject" class="">Subject</label>
                            <input type="text" id="subject" name="subject" class="form-control{{#if invalid.subject}} invalid{{/if}}" placeholder="Hello!" autocomplete="off" value="{{ values.subject }}">
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="md-form">
                            <label for="message">Message</label>
                            <textarea type="text" id="message" name="message" rows="2" class="form-control md-textarea{{#if invalid.message}} invalid{{/if}}" placeholder="This is your email content.">{{ values.message }}</textarea>
                            <div class="recaptcha-font">This site is protected by reCAPTCHA and the Google <a href="https://policies.google.com/privacy">Privacy Policy</a> and <a href="https://policies.google.com/terms">Terms of Service</a> apply.</div>
                        </div>
                    </div>
                </div>
                <div class="text-center">
                    <input type="text" id="g-recaptcha-response" name="g-recaptcha-response" value="" hidden>
                    <script src="//www.google.com/recaptcha/api.js?trustedtypes=true&render={{ recaptchaSiteKey }}" nonce="{{ nonce }}"></script>
                    <div class="text-md-left">
                        <input class="btn btn-primary" type="submit" value="Send Email">
                    </div>
                </div>
            </form>
            <div id="status"></div>
        </div>
    </div>
{{/if}}
</div>
