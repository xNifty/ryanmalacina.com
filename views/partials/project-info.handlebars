<div class="container" id="prj-index">
    <div class="project-hero">
        {{#iff authenticated '&&' isAdmin}}
            <div class="editbtn-wrapper">
                <a href="/projects/{{ project._id }}/edit" class="btn btn-primary btn-sm">
                    <span class="glyphicon glyphicon-pencil"></span> Edit Project
                </a>
            </div>
        {{/iff}}
        <h1>{{ project.title }}</h1>
        <div class="project-meta">
            {{#if project.source}}
                <a href="{{ project.source }}" target="_blank" rel="noopener noreferrer" class="project-badge">
                    <i class="fa fa-github" aria-hidden="true"></i> View Source
                </a>
            {{/if}}
            {{#if project.updatedAt}}
                <span class="project-badge">
                    <i class="fa fa-clock-o" aria-hidden="true"></i> Updated {{ formatDate project.updatedAt }}
                </span>
            {{/if}}
        </div>
    </div>
    <div class="project-content-card">
        <div class="markdown-body">
            {{{ descriptionHtml }}}
        </div>
    </div>
</div>
