<div class="container" id="site-news">
    <h1>Site News and Updates</h1>
    {{#iff news.length ">" 0}}
        <div class="panel-group">
            {{#each news as |news| }}
            <div class="panel panel-info">
                <div class="panel-heading collapsed">
                    <i class="fa fa-fw fa-chevron-down" data-toggle="collapse" data-target="#coll{{ @index }}"></i>
                    <i class="fa fa-fw fa-chevron-right" data-toggle="collapse" data-target="#coll{{ @index }}"></i>{{ news.title }} | {{ formatDate news.publishedAt }}
                </div>
                <div class="panel-collapse collapse custom-text" id="coll{{ @index }}">
                    <div class="panel-body">
                        {{{ news.bodyHtml }}}
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    {{else}}
        There is no news, or something went wrong.
    {{/iff}}
</div>