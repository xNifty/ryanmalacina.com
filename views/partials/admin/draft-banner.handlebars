{{!-- Shown by admin.js when the browser holds unsaved edits for this form (see data-draft-key) --}}
<div class="draft-banner" data-draft-banner hidden>
    <p>You have unsaved changes from <span data-draft-time></span>.</p>
    <div class="draft-banner__actions">
        <button type="button" class="button button--small button--primary" data-draft-restore>Restore them</button>
        <button type="button" class="button button--small" data-draft-discard>Discard</button>
    </div>
</div>
